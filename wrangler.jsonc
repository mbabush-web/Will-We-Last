{
  "name": "will-we-last",
  "compatibility_date": "2026-10-01",
  // Static site in public/; the small Worker in src/ only handles /api/* (the opt-in accuracy follow-up).
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Storage for the opt-in follow-up (table "followups" is created on first sign-up)
  "d1_databases": [{ "binding": "DB", "database_name": "will-we-last", "database_id": "6e98eb2c-790e-4197-8e81-86803155c33e" }]
}
